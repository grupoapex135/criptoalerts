# --- Telegram (obrigatório) ---
TELEGRAM_BOT_TOKEN=
# Deixe vazio na 1ª execução, mande /id ao bot e cole o número aqui.
# Só esse chat consegue usar /scan, /analyze e /status.
TELEGRAM_CHAT_ID=

# --- OpenAI (obrigatório) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- CoinGecko (opcional: sem chave usa o limite público) ---
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Binance (só dados públicos de mercado; nenhuma chave necessária) ---
BINANCE_BASE_URL=https://data-api.binance.vision

# --- Supabase (opcional: histórico + cooldown persistente) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Radar ---
SCAN_INTERVAL_MINUTES=60
TOP_COINS_TO_SCAN=200
MAX_AI_CANDIDATES=5

MIN_MARKET_CAP_USD=100000000
MIN_DAILY_VOLUME_USD=5000000
MAX_FDV_TO_MCAP_RATIO=3

CAPITAL_BRL=20000
MAX_POSITION_PCT=3

MIN_SCORE_TO_AI=55
MIN_CONFIDENCE_TO_ALERT=65
ALERT_COOLDOWN_HOURS=24
