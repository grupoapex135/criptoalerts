# --- Telegram (obrigatório) ---
TELEGRAM_BOT_TOKEN=
# Deixe vazio na 1ª execução, mande /id ao bot e cole o número aqui.
# Só esse chat consegue usar os comandos. Grupo = número negativo.
TELEGRAM_CHAT_ID=

# --- OpenAI (obrigatório) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- CoinGecko (opcional: sem chave usa o limite público; plano Demo é grátis) ---
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Binance (só dados públicos; nenhuma chave, nenhuma conta) ---
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# --- Supabase (opcional: histórico, placar dos sinais e watchlist persistentes) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Provedores pagos opcionais (vazio = camada usa fonte grátis ou fica sem dados) ---
# Unlocks futuros (Tokenomist, plano Pro ou acima)
TOKENOMIST_API_KEY=
# Derivativos multi-exchange; sem chave usa Binance Futures (grátis)
COINGLASS_API_KEY=
# Social (LunarCrush, plano Individual/Builder)
LUNARCRUSH_API_KEY=
# Manchetes (NewsData.io, tem plano grátis)
NEWSDATA_API_KEY=

# --- Camadas (liga/desliga) ---
ENABLE_TOKENOMICS=true
ENABLE_DERIVATIVES=true
ENABLE_SOCIAL=true
# Interface pronta; nenhum provedor on-chain configurado ainda
ENABLE_ONCHAIN=false
# Hacks do DefiLlama (grátis) + manchetes, se houver chave
ENABLE_NEWS=true

# --- Radar ---
SCAN_INTERVAL_MINUTES=60
TOP_COINS_TO_SCAN=200
MAX_AI_CANDIDATES=5

MIN_MARKET_CAP_USD=100000000
MIN_DAILY_VOLUME_USD=5000000
MAX_FDV_TO_MCAP_RATIO=3

CAPITAL_BRL=20000
MAX_POSITION_PCT=3

# Nota mínima (média ponderada das subnotas) para chegar à IA
MIN_SCORE_TO_AI=55
MIN_CONFIDENCE_TO_ALERT=65
# Em risk_off a confiança mínima sobe para este valor (e a nota mínima sobe 10 pontos)
MARKET_RISK_OFF_MIN_CONFIDENCE=80
# Unlock (ou crescimento de oferta) acima deste % em 30 dias bloqueia o alerta
CRITICAL_UNLOCK_30D_PCT=10
ALERT_COOLDOWN_HOURS=24

# --- Acompanhamento dos sinais (horizonte de médio/longo prazo) ---
TRACKER_INTERVAL_MINUTES=30
OPPORTUNITY_EXPIRY_DAYS=90

# --- Modo Pré-Binance: ativos que ainda NÃO estão no spot da Binance ---
ENABLE_PRE_LISTING=true
# Universo ampliado (top N do CoinGecko). Cada 250 = 1 chamada por varredura.
PRE_LISTING_TOP_N=1000
PRE_LISTING_MIN_MCAP_USD=10000000
PRE_LISTING_MAX_MCAP_USD=1000000000
PRE_LISTING_MIN_VOLUME_USD=250000
# Teto de análises de IA por varredura só para pré-listagem (soma ao MAX_AI_CANDIDATES)
PRE_LISTING_MAX_AI_CANDIDATES=3
